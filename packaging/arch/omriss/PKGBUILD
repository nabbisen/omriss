# Maintainer: nabbisen
#
# Source of truth: packaging/arch/omriss/PKGBUILD in
# https://github.com/nabbisen/omriss, a template that scripts/render-pkgbuild.sh
# fills in. This copy is only where it is published; change it there, not here.

# The upstream name, which is not the package name when a scratch package is
# published for a rehearsal (RFC-072 §7): the tag archive unpacks to omriss-$pkgver.
_name=omriss
pkgname=@PKGNAME@
pkgver=@PKGVER@
pkgrel=1
pkgdesc='A text editor that helps clarify ideas and refine them, layer by layer'
arch=('x86_64')
url='https://github.com/nabbisen/omriss'
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'xdotool' 'openssl')
makedepends=('rust' 'pkgconf')
source=("$_name-$pkgver.tar.gz::@SOURCE_URL@")
sha256sums=('@SHA256@')

prepare() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p omriss
}

package() {
  cd "$_name-$pkgver"
  install -Dm755 target/release/omriss -t "$pkgdir/usr/bin"
  install -Dm644 packaging/linux/io.github.nabbisen.omriss.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 packaging/linux/io.github.nabbisen.omriss.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/io.github.nabbisen.omriss.png"
  install -Dm644 packaging/linux/io.github.nabbisen.omriss.metainfo.xml -t "$pkgdir/usr/share/metainfo"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
