# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is COMMITTED: this workspace ships an executable, and both the AUR
# package (`cargo fetch --locked`) and the Flatpak build (its offline source
# list is generated from the lockfile) fail without it. RFC-072 §2, RFC-074 §5.2.
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# mdBook render output (`mdbook build docs`)
docs/book/

# custom
/.git-exclude/
*.local.json
